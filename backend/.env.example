# Copy to .env and adjust as needed. All values have safe defaults.

# SQLite connection string (relative to the backend/ directory, or absolute).
DATABASE_URL=sqlite:///./research_os.db

# Comma-separated list of allowed browser origins for the frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# GLM runtime credentials (Phase 3 AI analysis)
# These belong to the APPLICATION's own plan/quota. They are deliberately read
# ONLY from RESEARCH_OS_GLM_* variables or this file — a coding agent's own
# GLM_API_KEY / ZAI_* environment variables can never be picked up here.
# ---------------------------------------------------------------------------
RESEARCH_OS_GLM_API_KEY=
RESEARCH_OS_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RESEARCH_OS_GLM_MODEL=glm-4-flash
RESEARCH_OS_GLM_TIMEOUT_SECONDS=60

# Conversation import / analysis limits
# CONVERSATION_MAX_CHARS=200000
# SEGMENT_MAX_CHARS=12000

